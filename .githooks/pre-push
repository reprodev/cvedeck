#!/bin/sh
# Refuse to push a secret, a credential-shaped file, or anything an ignore rule
# says should stay local -- over everything the push would publish.
#
# The diff *and* the final tree are scanned, because history is published too: a
# secret added in one commit and deleted in the next still leaks, and a
# forbidden file that predates the range is still in the tree you are pushing.
#
# This runs for every remote. It is the check that matters in any clone, so
# there is nothing to decide about where the push is going.
#
# What this does NOT do, because CI does it better: run the test suites. CI runs
# both suites and the image build on every pull request, and a hook that refuses
# to back up work in progress is a hook that gets disabled.
#
# --no-verify skips every check here, the secret scan included. Reach for it
# only when you have already looked at what you are pushing.
#
# ---------------------------------------------------------------------------
# A maintainer publishing a release needs more than this -- branch policy,
# commit identity, version consistency. Those checks are specific to how this
# repository is published rather than to the code, so they live in an untracked
# local overlay rather than here. If .githooks/local-policy.sh exists it is
# sourced below and fills in the hooks left as no-ops; absent is fine, and is
# what a contributor's clone looks like.
# ---------------------------------------------------------------------------

. "$(dirname "$0")/_checks.sh"

REMOTE_NAME="$1"
REMOTE_URL="$2"

# Seams for the local overlay. Defined as no-ops first so the hook is complete
# on its own, then redefined by local-policy.sh when that exists.
cvedeck_policy_init()      { :; }
cvedeck_policy_delete()    { :; }
cvedeck_policy_ref_early() { return 0; }
cvedeck_policy_ref_late()  { return 0; }
cvedeck_policy_final()     { :; }

CVEDECK_LOCAL_POLICY="$(dirname "$0")/local-policy.sh"
# shellcheck source=/dev/null
[ -f "$CVEDECK_LOCAL_POLICY" ] && . "$CVEDECK_LOCAL_POLICY"

ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

printf '\n  pre-push: remote "%s"\n' "$REMOTE_NAME"
printf '  denylist: %s\n' "$(cvedeck_denylist_status)"
cvedeck_policy_init

FAIL=0
SAW_REF=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    # A deletion pushes the zero sha as the local side. Nothing to inspect.
    if [ "$LOCAL_SHA" = "$ZERO" ]; then
        cvedeck_policy_delete
        continue
    fi
    SAW_REF=1

    # Policy first, before anything expensive: there is no point scanning a ref
    # that is already refused.
    cvedeck_policy_ref_early || continue

    if [ "$REMOTE_SHA" = "$ZERO" ]; then
        BASE="$CVEDECK_EMPTY_TREE"
    else
        BASE="$REMOTE_SHA"
    fi

    # The range as *commits*, for scanning history. On a first push BASE is the
    # empty tree rather than a commit, and `git log <tree>..<sha>` is an error,
    # so the range is built from commits only -- the same trap the identity
    # check fell into once, where a discarded error read as "nothing to report"
    # on the very push where it mattered most.
    if [ "$BASE" = "$CVEDECK_EMPTY_TREE" ]; then
        SCAN_RANGE="$LOCAL_SHA"
    else
        SCAN_RANGE="$BASE..$LOCAL_SHA"
    fi

    # Every path touched by any commit in the range, plus every path in the tree
    # being published. The first catches a secret added and then deleted; the
    # second catches a forbidden file that predates the range.
    #
    # `git log --name-only`, not `git diff BASE LOCAL`. A two-dot diff compares
    # two trees, so a file added in one commit and removed in the next nets out
    # to nothing and is never seen -- which is precisely the case this check
    # claimed to cover, and did not, from 0.6.0 until 0.8.12. History is
    # published: a secret is leaked by having been committed, not by surviving
    # to the tip.
    #
    # Each commit is scanned on its own, so a merge needs no special handling:
    # everything it brings in is reachable in the range and scanned there.
    PATHS=$(
        { git log --format= --name-only "$SCAN_RANGE"
          git ls-tree -r --name-only "$LOCAL_SHA"
        } | sed '/^$/d' | sort -u
    )

    OFF_PATHS=$(printf '%s\n' "$PATHS" | cvedeck_check_paths) || {
        cvedeck_banner "files that must not be published"
        printf '%s\n' "$OFF_PATHS"
        printf '\n  These are in %s. Remove them from the history you are pushing,\n' "$REMOTE_REF"
        printf '  not just from the working tree.\n\n'
        FAIL=1
    }

    OFF_FORCED=$(cvedeck_check_force_added "$LOCAL_SHA") || {
        cvedeck_banner "tracked files that an ignore rule says should stay local"
        printf '%s\n' "$OFF_FORCED"
        printf '\n  These were added past an ignore rule with git add -f. Remove them\n'
        printf '  from the commits being pushed, not just from the working tree.\n\n'
        FAIL=1
    }

    # Per-commit patches, for the same reason as the paths above: a line added
    # and later removed does not appear in a two-dot diff, and it is still in
    # the history being pushed.
    OFF_LINES=$(git log -p --unified=0 --format= "$SCAN_RANGE" | cvedeck_check_added_lines) || {
        cvedeck_banner "content that must not be published"
        printf '%s\n' "$OFF_LINES"
        printf '\n  Found in lines added between %s and %s.\n' "$(git rev-parse --short "$BASE" 2>/dev/null || echo 'the empty tree')" "$(git rev-parse --short "$LOCAL_SHA")"
        printf '  To locate it:  git log -p -S"<the string>" %s\n\n' "$LOCAL_SHA"
        FAIL=1
    }

    cvedeck_policy_ref_late
done

if [ "$SAW_REF" -eq 0 ] && [ "$FAIL" -eq 0 ]; then
    printf '  nothing to push.\n\n'
    exit 0
fi

cvedeck_policy_final

if [ "$FAIL" -ne 0 ]; then
    printf '  Nothing was pushed.\n\n' >&2
    exit 1
fi

printf '  all checks passed -- pushing.\n\n'
exit 0
