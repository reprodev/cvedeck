[Unit]
Description=CveDeck -- refresh threat-intel feeds (CISA KEV, FIRST EPSS)
Documentation=https://github.com/reprodev/cvedeck
After=network-online.target cvedeck.service
Wants=network-online.target
# The API has to be up to accept the refresh. A run that fires while it is
# restarting simply fails and the timer retries tomorrow -- the previous cache
# is left intact, so a missed refresh degrades to stale data, never to none.
Requires=cvedeck.service

[Service]
Type=oneshot

# Downloads the KEV catalogue and the EPSS score set and replaces the local
# cache. Enrichment is applied at scan time, so this takes effect on the next
# scan rather than retroactively.
#
# --max-time is generous because the EPSS set is a few megabytes. --fail makes
# curl exit non-zero on an HTTP error so a failed refresh shows up in
# `systemctl status` rather than passing silently.
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 300 \
    -X POST http://127.0.0.1:8000/api/feeds/refresh

# The endpoint is on loopback and reads nothing from disk, so this unit needs
# almost no access to the system at all.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
