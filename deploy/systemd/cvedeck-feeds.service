[Unit]
Description=CveDeck -- refresh threat-intel feeds (CISA KEV, FIRST EPSS)
Documentation=https://github.com/reprodev/cvedeck
After=network-online.target cvedeck.service
Wants=network-online.target

[Service]
Type=oneshot

# Downloads the KEV catalogue and the EPSS score set and replaces the local
# cache. Enrichment is applied at scan time, so this takes effect on the next
# scan rather than retroactively.
#
# Runs on the host against the database directly rather than calling the API:
# the API requires a login, and a process that can already read the database
# has nothing to prove with a token. Exits non-zero if either feed failed, so a
# failed refresh shows up in `systemctl status` rather than passing silently.
# A failed refresh leaves the previous cache intact, so a missed run degrades
# to stale data, never to none.
User=cvedeck
Group=cvedeck
EnvironmentFile=/etc/cvedeck/cvedeck.env
ExecStart=/opt/cvedeck/venv/bin/cvedeck-admin refresh-feeds

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# The database lives here; everything else stays read-only.
ReadWritePaths=/var/lib/cvedeck
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
