# Example nginx reverse proxy for the CveDeck.
#
# CveDeck requires a login by default. Terminate TLS here: over plain HTTP the
# password, the session cookie and scan credentials cross the network readable.
# An extra access layer (auth_basic below, or an identity-aware proxy) is still
# worth adding before exposing it to the internet.
#
# Copy to /etc/nginx/sites-available/cvedeck, adjust server_name and the
# certificate paths, then symlink into sites-enabled and reload nginx.

server {
    listen 80;
    server_name cvedeck.example.com;

    # Redirect everything to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cvedeck.example.com;

    ssl_certificate     /etc/letsencrypt/live/cvedeck.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cvedeck.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    server_tokens       off;

    # Only what belongs to the TLS layer. CveDeck sends its own content policy,
    # framing, referrer and nosniff headers on every response; adding them here
    # as well would give the browser two policies to enforce at once.
    # Remove "includeSubDomains" if other names under this domain are not HTTPS.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Scan requests carry target credentials; do not log request bodies.
    access_log /var/log/nginx/cvedeck.access.log;
    error_log  /var/log/nginx/cvedeck.error.log;

    # Inventory payloads from large fleets can be sizeable.
    client_max_body_size 16m;

    location / {
        # Optional second layer in front of CveDeck's own login.
        # auth_basic "CVE Scanner";
        # auth_basic_user_file /etc/nginx/cvedeck.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # Host must be passed through: CveDeck refuses a state-changing request
        # whose Origin does not match it, and CVEDECK_ALLOWED_HOSTS checks it.
        # X-Forwarded-Proto lets it mark the session cookie Secure; uvicorn
        # trusts it from 127.0.0.1 by default.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # POST /api/scans is synchronous: it connects to every target over
        # SSH/WinRM inline and only responds when the whole batch is done. The
        # 60s default would cut off any multi-host scan.
        proxy_connect_timeout 30s;
        proxy_send_timeout    900s;
        proxy_read_timeout    900s;

        # Streaming is not used; buffering keeps slow clients off the backend.
        proxy_buffering on;
    }
}
