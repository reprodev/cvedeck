# Copy to .env and edit. Used by docker-compose.yml.
# Every value here is optional -- the defaults shown are what compose uses.

# Host port the dashboard is published on (http://<host>:<PORT>).
# 3325 is chosen to avoid the ports other self-hosted apps already claim; change
# it here if something on your host uses it.
PORT=3325

# Host directory holding the database. Back this up.
# Use an absolute path in production, e.g. /srv/cvedeck/data
DATA_DIR=./data

# Ownership of the files written into DATA_DIR. Set these to the host user that
# should own the database (`id -u` and `id -g`).
PUID=1000
PGID=1000

TZ=UTC

# --- Application overrides (rarely needed) ---------------------------------
# Full database URL. Overrides the SQLite file under /data. Requires the
# psycopg driver, which is already installed in the image.
# CVEDECK_DB_URL=postgresql+psycopg://user:password@host/cvedeck

# Online database for POST /api/sync. Without it, sync reports HTTP 503.
# CVEDECK_ONLINE_DB_URL=postgresql+psycopg://user:password@host/cvedeck

# Remoting ports used when scanning targets.
# CVEDECK_SSH_PORT=22
# CVEDECK_WINRM_PORT=5985
# CVEDECK_WINRM_SCHEME=http

# Only needed if you serve the dashboard from a different origin than the API.
# CVEDECK_CORS_ORIGINS=https://dashboard.example.com

# --- Threat intelligence (KEV / EPSS) --------------------------------------
# The CISA KEV catalogue and FIRST EPSS score set are downloaded whole and
# cached locally, then joined onto findings at scan time. Refresh them with
# POST /api/feeds/refresh -- there is no scheduler yet, so put it on a daily
# cron. Both publish daily. See DEPLOYMENT.md "Keeping threat intel fresh".
#
# How stale a cache may get before the dashboard flags it. Default 48h, which
# tolerates exactly one missed publication.
# CVEDECK_FEED_MAX_AGE_HOURS=48

# Timeout for a whole-feed download. Separate from CVEDECK_HTTP_TIMEOUT
# because the EPSS set is a few megabytes, not a per-package API call.
# CVEDECK_FEED_TIMEOUT=120

# Override the feed URLs (for an internal mirror, or an air-gapped network).
# CVEDECK_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# CVEDECK_EPSS_FEED_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz

# --- OS-level CVE matching via NVD (opt-in) --------------------------------
# Off by default. NVD allows 5 requests per rolling 30 seconds without a key,
# which makes an unkeyed fleet scan slow. Get a free key first:
#   https://nvd.nist.gov/developers/request-an-api-key
# CVEDECK_NVD_ENABLED=true
# CVEDECK_NVD_API_KEY=your-key-here

# --- Demo mode (off by default) --------------------------------------------
# Seeds a fictional fleet into an empty database so the dashboard has something
# to show, and REFUSES scans, discovery sweeps, and connection tests.
#
# That refusal is the point. Without it, a public instance is an SSH/WinRM
# client and port scanner that any visitor can aim at any address, with the
# traffic originating from your server. Only enable this on an instance you are
# deliberately exposing as a demo.
#
# Seeding is guarded on an empty fleet, so enabling it against a database that
# already holds real results does nothing.
# CVEDECK_DEMO_MODE=true

# --- Login (on by default) --------------------------------------------------
# On first start with no account, the log prints a one-time setup code for the
# dashboard's "Create your account" page. To create the account here instead,
# set both; neither ever changes an account that already exists. Prefer the
# _FILE form, so the password is not in this file or in `docker inspect`.
# CVEDECK_ADMIN_USERNAME=admin
# CVEDECK_ADMIN_PASSWORD_FILE=/run/secrets/cvedeck_admin_password
# CVEDECK_ADMIN_PASSWORD=
#
# Mark the session cookie Secure: auto (when the request is HTTPS), true, false.
# CVEDECK_COOKIE_SECURE=auto
#
# Serve everything without login. Only behind a proxy that authenticates people
# (Authelia, Authentik, oauth2-proxy). Any value other than disabled/off/false/
# no/0 leaves login on.
# CVEDECK_AUTH=disabled
